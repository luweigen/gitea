<script type="module">
import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs';
import elkLayouts from 'https://cdn.jsdelivr.net/npm/@mermaid-js/layout-elk/dist/mermaid-layout-elk.esm.min.mjs';
import svgPanZoom from 'https://cdn.jsdelivr.net/npm/svg-pan-zoom@3.6.2/+esm';

// mermaid 配色主题:亮色站点下 'default' 是标准彩色,'neutral' 是灰度,
// 还可选 'forest' / 'base';暗色站点固定用 'dark'
const THEME_LIGHT = 'default';
const THEME_DARK = 'dark';

mermaid.registerLayoutLoaders(elkLayouts);
mermaid.initialize({
  startOnLoad: false,
  theme: document.documentElement.getAttribute('data-theme') === 'dark' ? THEME_DARK : THEME_LIGHT,
  securityLevel: 'strict',
  suppressErrorRendering: true,
});

// 高度自适应参数:框高随图形宽高比等比增长
//   MAX_HEIGHT 设为正数  -> 封顶到该值(超出部分用缩放/平移查看)
//   MAX_HEIGHT 设为 0 或 Infinity -> 不封顶,框高完全随图形增长
//   MIN_HEIGHT 与 MAX_HEIGHT 设为同一正数 -> 固定高度
const MIN_HEIGHT = 80;
const MAX_HEIGHT = 0;
const HAS_CAP = Number.isFinite(MAX_HEIGHT) && MAX_HEIGHT > 0;

// 导出 PNG 的放大倍数(相对图形自然尺寸),越大文字越清晰、文件越大
const EXPORT_SCALE = 2;

// 有些图(如 radar-beta)会把轴标签、图例画到自己声明的 viewBox 之外,靠 overflow="visible"
// 在页面上勉强露出来;而 <img> 光栅化严格按 viewBox 裁切,导出的 PNG 里这些标签就被切掉。
// 这里量出真实内容包围盒,把 viewBox 按需往外扩,页面显示与导出都按完整内容来。
// 注意 getBBox 要求元素已经在文档里渲染过。
const VIEWBOX_PADDING = 2;
// 每一侧最多扩大到声明尺寸的多少倍(0.25 = 25%)。gantt 之类的图会把辅助图形画到很远的
// 空白处,不设上限会把图挤成一条线,所以某一侧超出太多时就维持原样(等于沿用 mermaid
// 自己的裁切),只兜住标签溢出这种小幅超界
const MAX_VIEWBOX_GROWTH = 0.25;
function fitViewBoxToContent(svgEl) {
  const vb = (svgEl.getAttribute('viewBox') || '').split(/[\s,]+/).map(Number);
  const declared = (vb.length === 4 && vb.every((n) => Number.isFinite(n)) && vb[2] > 0 && vb[3] > 0) ? vb : null;
  let box = null;
  try {
    box = svgEl.getBBox();
  } catch {
    box = null;
  }
  if (!box || !(box.width > 0) || !(box.height > 0)) return declared;

  let x1 = box.x - VIEWBOX_PADDING;
  let y1 = box.y - VIEWBOX_PADDING;
  let x2 = box.x + box.width + VIEWBOX_PADDING;
  let y2 = box.y + box.height + VIEWBOX_PADDING;
  if (declared) {
    const [dx, dy, dw, dh] = declared;
    const maxGrowX = dw * MAX_VIEWBOX_GROWTH;
    const maxGrowY = dh * MAX_VIEWBOX_GROWTH;
    // 只往外扩、不往里收;超出超过上限的那一侧直接放弃
    x1 = (dx - x1 <= maxGrowX) ? Math.min(x1, dx) : dx;
    y1 = (dy - y1 <= maxGrowY) ? Math.min(y1, dy) : dy;
    x2 = (x2 - (dx + dw) <= maxGrowX) ? Math.max(x2, dx + dw) : dx + dw;
    y2 = (y2 - (dy + dh) <= maxGrowY) ? Math.max(y2, dy + dh) : dy + dh;
  }
  const fitted = [x1, y1, x2 - x1, y2 - y1];
  svgEl.setAttribute('viewBox', fitted.join(' '));
  return fitted;
}

// mermaid 默认用 htmlLabels(foreignObject 里包 HTML)渲染标签,而部分浏览器(Safari)
// 无法把 SVG 里的 foreignObject 光栅化到 canvas —— 图能画出来但标签是空白。
// 这里用一张 8x8 的探针图实测一次能力,不做 UA 嗅探。
let foreignObjectOk = null;
async function canRasterizeForeignObject() {
  if (foreignObjectOk !== null) return foreignObjectOk;
  const probe = '<svg xmlns="http://www.w3.org/2000/svg" width="8" height="8">'
    + '<foreignObject width="8" height="8">'
    + '<div xmlns="http://www.w3.org/1999/xhtml" style="width:8px;height:8px;background:#000"></div>'
    + '</foreignObject></svg>';
  try {
    const img = new Image();
    await new Promise((resolve, reject) => {
      img.onload = resolve;
      img.onerror = () => reject(new Error('探针图加载失败'));
      img.src = 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(probe);
    });
    const canvas = document.createElement('canvas');
    canvas.width = 8;
    canvas.height = 8;
    const ctx = canvas.getContext('2d');
    ctx.fillStyle = '#ffffff';
    ctx.fillRect(0, 0, 8, 8);
    ctx.drawImage(img, 0, 0, 8, 8);
    // foreignObject 里的黑色方块画出来了才算支持
    foreignObjectOk = ctx.getImageData(0, 0, 8, 8).data[0] < 128;
  } catch {
    foreignObjectOk = false;
  }
  return foreignObjectOk;
}

async function renderMermaid(el) {
  const pre = el.closest('pre');
  if (!pre || pre.hasAttribute('data-render-done')) return;
  // 两个属性分别阻止旧版与新版 Gitea 内置的 mermaid 渲染
  pre.setAttribute('data-render-done', 'true');
  pre.setAttribute('data-markup-mermaid-rendered', 'true');

  const source = el.textContent;
  const id = 'mermaid-' + Math.random().toString(36).slice(2);

  try {
    const {svg, bindFunctions} = await mermaid.render(id, source);

    // 外层容器
    const block = document.createElement('div');
    block.className = 'mermaid-block';
    block.style.cssText = 'position:relative; border:1px solid var(--color-secondary); border-radius:4px; overflow:hidden;';

    // SVG 容器(高度稍后根据图形宽高比自适应计算)
    const svgContainer = document.createElement('div');
    svgContainer.style.cssText = 'width:100%; background:var(--color-box-body);';
    svgContainer.innerHTML = svg;
    block.appendChild(svgContainer);

    // 控制按钮
    const controls = document.createElement('div');
    // 放左上角,避免与 Gitea 在右上角加的复制按钮重叠
    controls.style.cssText = 'position:absolute; top:8px; left:8px; display:flex; gap:4px; z-index:10;';
    controls.innerHTML = `
      <button type="button" class="ui mini icon button" data-act="zoom-in" title="放大">+</button>
      <button type="button" class="ui mini icon button" data-act="reset" title="重置">⟲</button>
      <button type="button" class="ui mini icon button" data-act="zoom-out" title="缩小">−</button>
      <button type="button" class="ui mini icon button" data-act="fit" title="适应">⛶</button>
      <button type="button" class="ui mini icon button" data-act="export" title="导出 PNG">⤓</button>
    `;
    block.appendChild(controls);

    pre.replaceWith(block);
    bindFunctions?.(svgContainer);

    // 需要让 SVG 自适应容器
    const svgEl = svgContainer.querySelector('svg');
    svgEl.setAttribute('width', '100%');
    svgEl.setAttribute('height', '100%');
    svgEl.style.maxWidth = 'none';

    // 先把 viewBox 扩到能装下全部内容(radar 等图的标签会画到 viewBox 外面),
    // 再据此读取图形真实宽高比,用于按容器宽度等比换算高度
    const vb = fitViewBoxToContent(svgEl);
    const aspect = vb ? vb[2] / vb[3] : null;

    // 根据当前容器宽度计算自适应高度
    const fitHeight = () => {
      const w = svgContainer.clientWidth || block.clientWidth;
      if (!w) return;
      // 按容器宽度等比换算自然高度;没有有效 viewBox 时退回到封顶值/600
      const natural = aspect ? w / aspect : (HAS_CAP ? MAX_HEIGHT : 600);
      let h = Math.max(MIN_HEIGHT, natural);
      if (HAS_CAP) h = Math.min(h, MAX_HEIGHT);
      svgContainer.style.height = h + 'px';
    };

    fitHeight();

    // 初始化 pan-zoom(fit 让图形完整放入自适应后的视口)
    const panZoom = svgPanZoom(svgEl, {
      zoomEnabled: true,
      controlIconsEnabled: false,
      fit: true,
      center: true,
      minZoom: 0.1,
      maxZoom: 20,
      zoomScaleSensitivity: 0.3,
    });

    // 导出 PNG:用 mermaid 原始 SVG 字符串(未被 pan-zoom 改过)按自然尺寸离屏渲染,
    // 因此无论当前缩放/平移到哪里,导出的都是完整图形。这里有两个坑:
    //   1. mermaid 返回的 SVG 字符串是 HTML 序列化的结果,文本里的不换行空格(U+00A0)
    //      会写成 &nbsp;,而 XML 没有这个实体 —— 按 image/svg+xml 解析会直接失败
    //      (Chrome 与 Safari 都会),这是"SVG 图像加载失败"的真正原因。改按 text/html
    //      解析(实体表齐全,DOMParser 也不会执行脚本),再用 XMLSerializer 序列化回
    //      合法 XML。
    //   2. Chrome 把含 foreignObject 的 SVG 从 blob: URL 装进 <img> 后会污染 canvas,
    //      导致 toBlob 抛 SecurityError;改用 data: URL 则不会。
    async function svgToPngBlob(svgText) {
      const parsed = new DOMParser().parseFromString(svgText, 'text/html').querySelector('svg');
      if (!parsed) throw new Error('SVG 解析失败');
      const root = document.importNode(parsed, true);

      // 离屏挂一下才量得到内容包围盒,据此把 viewBox 扩到不裁切标签
      const measureHost = document.createElement('div');
      measureHost.style.cssText = 'position:absolute; left:-99999px; top:0; opacity:0; pointer-events:none;';
      measureHost.appendChild(root);
      document.body.appendChild(measureHost);
      let evb;
      try {
        evb = fitViewBoxToContent(root);
      } finally {
        measureHost.remove();
      }

      const w = evb ? evb[2] : (svgContainer.clientWidth || 800);
      const h = evb ? evb[3] : (svgContainer.clientHeight || 600);
      root.setAttribute('width', String(Math.round(w * EXPORT_SCALE)));
      root.setAttribute('height', String(Math.round(h * EXPORT_SCALE)));
      root.style.maxWidth = 'none';

      const svgUrl = 'data:image/svg+xml;charset=utf-8,'
        + encodeURIComponent(new XMLSerializer().serializeToString(root));
      const img = new Image();
      await new Promise((resolve, reject) => {
        img.onload = resolve;
        img.onerror = () => reject(new Error('SVG 图像加载失败'));
        img.src = svgUrl;
      });
      const canvas = document.createElement('canvas');
      canvas.width = Math.round(w * EXPORT_SCALE);
      canvas.height = Math.round(h * EXPORT_SCALE);
      const ctx = canvas.getContext('2d');
      // 填上容器背景色,避免透明底的 PNG 在深色主题/看图软件里发黑
      const bg = getComputedStyle(svgContainer).backgroundColor;
      ctx.fillStyle = (!bg || bg === 'rgba(0, 0, 0, 0)') ? '#ffffff' : bg;
      ctx.fillRect(0, 0, canvas.width, canvas.height);
      ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
      const blob = await new Promise((resolve) => canvas.toBlob(resolve, 'image/png'));
      if (!blob) throw new Error('PNG 编码失败');
      return blob;
    }

    // 用纯 SVG <text> 标签(htmlLabels:false)重新渲染一份专供导出,页面显示不受影响。
    // init 指令插在 YAML frontmatter 之后,免得破坏图自带的配置
    async function renderWithTextLabels() {
      const directive = '%%{init: {"flowchart":{"htmlLabels":false},"class":{"htmlLabels":false}}}%%\n';
      const fm = /^---\r?\n[\s\S]*?\r?\n---\r?\n/.exec(source);
      const exportSource = fm
        ? source.slice(0, fm[0].length) + directive + source.slice(fm[0].length)
        : directive + source;
      const {svg: textLabelSvg} = await mermaid.render(id + '-export-' + Math.random().toString(36).slice(2), exportSource);
      return textLabelSvg;
    }

    async function exportPng() {
      // 能光栅化 foreignObject 就直接用页面上这份 SVG(排版与页面完全一致),
      // 不能的话(Safari)换成纯文本标签的版本,免得导出的图标签是空白
      const useOriginal = await canRasterizeForeignObject();
      let blob;
      try {
        blob = await svgToPngBlob(useOriginal ? svg : await renderWithTextLabels());
      } catch (err) {
        if (!useOriginal) throw err;
        console.warn('原始 SVG 导出失败,改用 htmlLabels:false 重新渲染导出:', err);
        blob = await svgToPngBlob(await renderWithTextLabels());
      }
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = id + '.png';
      a.click();
      URL.revokeObjectURL(a.href);
    }

    controls.addEventListener('click', (e) => {
      const act = e.target.closest('button')?.dataset.act;
      if (!act) return;
      if (act === 'zoom-in') panZoom.zoomIn();
      else if (act === 'zoom-out') panZoom.zoomOut();
      else if (act === 'reset') panZoom.resetZoom(), panZoom.center();
      else if (act === 'fit') panZoom.fit(), panZoom.center();
      else if (act === 'export') exportPng().catch((err) => console.error('PNG 导出失败:', err));
    });

    // 容器宽度变化时重新计算高度并适应(用宽度变化做防抖,避免改高度引发的回环)
    let lastWidth = svgContainer.clientWidth;
    new ResizeObserver(() => {
      const w = svgContainer.clientWidth;
      if (w !== lastWidth) {
        lastWidth = w;
        fitHeight();
      }
      panZoom.resize();
      panZoom.fit();
      panZoom.center();
    }).observe(svgContainer);
  } catch (err) {
    console.error('Mermaid render error:', err);
    pre.innerHTML = `<code style="color:red;">Mermaid error: ${err.message}</code>`;
  }
}

const observer = new MutationObserver((mutations) => {
  for (const m of mutations) {
    for (const node of m.addedNodes) {
      if (node.nodeType !== 1) continue;
      node.querySelectorAll?.('code.language-mermaid').forEach(renderMermaid);
    }
  }
});
observer.observe(document.body, {childList: true, subtree: true});
document.querySelectorAll('code.language-mermaid').forEach(renderMermaid);
</script>
