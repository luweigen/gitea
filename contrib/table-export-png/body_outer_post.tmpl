{{/* Markdown 渲染结果里的表格，以及含数学公式的段落/列表项/引用块等 ——
     悬停时在右上角显示一个按钮，点击把这一块导出成 PNG 图片。
     纯自定义模板方案：不改 Gitea 源码、不重新编译前端资源，也不引入任何外部依赖。

     页面加载时不扫描 DOM、不改 DOM、不装 MutationObserver：只建一个浮动按钮和几个
     事件监听，开销与文档长度无关；「这一块能不能导出」推迟到鼠标悬停时才判断。 */}}
<script>
(() => {
	'use strict';

	// ------------------------------ 可调参数 ------------------------------
	const EXPORT_SCALE = 2;              // 导出倍率（1 = 与屏幕等大，2 = 两倍分辨率，文字更清晰）
	const PADDING = 8;                   // 导出内容四周的留白（CSS 像素）
	const MAX_CANVAS_SIDE = 8192;        // canvas 单边上限，超大内容会自动降低倍率
	// 表格总是可以导出；下面这些块级元素只有在包含数学公式（KaTeX）时才给按钮，
	// 否则每个段落上都冒出一个按钮太吵。
	const TABLE_SELECTOR = '.markup table';
	const BLOCK_SELECTOR = ['p', 'li', 'blockquote', 'dd', 'dt', 'h1', 'h2', 'h3', 'h4', 'h5', 'h6']
		.map((tag) => `.markup ${tag}`).join(', ');
	const MATH_SELECTOR = '.katex';

	// ------------------------------ 小工具 ------------------------------
	const isTransparent = (color) => !color || color === 'transparent' ||
		/^rgba?\(\s*\d+\s*,\s*\d+\s*,\s*\d+\s*,\s*0\s*\)$/.test(color);

	// getComputedStyle 返回的是活对象，缓存起来跨次导出复用也不会读到过期值
	const styleCache = new WeakMap();
	function styleOf(el) {
		let style = styleCache.get(el);
		if (!style) {
			style = getComputedStyle(el);
			styleCache.set(el, style);
		}
		return style;
	}

	function hasBorder(style) {
		for (const side of ['Top', 'Right', 'Bottom', 'Left']) {
			const lineStyle = style[`border${side}Style`];
			if (lineStyle === 'none' || lineStyle === 'hidden') continue;
			if ((parseFloat(style[`border${side}Width`]) || 0) > 0 && !isTransparent(style[`border${side}Color`])) return true;
		}
		return false;
	}

	// 悬停时才判断：表格整张导出；其它块级元素含公式才导出。含公式的结果可以缓存，
	// 不含的不缓存 —— KaTeX 是异步渲染的，晚一点公式才出现。
	const hasMathCache = new WeakSet();
	function hasMath(el) {
		if (hasMathCache.has(el)) return true;
		if (!el.querySelector(MATH_SELECTOR)) return false;
		hasMathCache.add(el);
		return true;
	}

	function exportTarget(el) {
		const table = el.closest(TABLE_SELECTOR);
		if (table) return table;                       // 表格里的段落等，仍然整张表导出
		let block = el.closest(BLOCK_SELECTOR);
		if (!block) return null;
		// 引用块里的段落，连同左边的竖线整块导出
		const quote = block.closest('.markup blockquote');
		if (quote) block = quote;
		return hasMath(block) ? block : null;
	}

	// 只画肉眼看得到的东西。除了 display:none / visibility:hidden，还要排除"无障碍专用、
	// 视觉上被裁掉"的元素：KaTeX 每个公式都会同时输出一份 MathML（用 clip-path 裁成 1px
	// 只给读屏软件）和一份可见的 HTML，不排除掉前者，导出的公式就会重影。
	function isVisible(el) {
		const style = styleOf(el);
		if (style.display === 'none' || style.visibility === 'hidden' || Number(style.opacity) === 0) return false;
		if (/inset\(\s*50%/.test(style.clipPath || '')) return false; // clip-path: inset(50%)
		if (style.clip && style.clip !== 'auto') {                    // 旧写法 clip: rect(1px, 1px, 1px, 1px)
			const n = (style.clip.match(/-?[\d.]+/g) || []).map(Number);
			if (n.length === 4 && (n[1] - n[3] <= 1 || n[2] - n[0] <= 1)) return false;
		}
		if (style.overflow === 'hidden') {
			const rect = el.getBoundingClientRect();
			if (rect.width <= 1 || rect.height <= 1) return false;
		}
		return true;
	}

	// 深度优先收集可见元素，整棵子树被隐藏时直接剪枝：clip-path 这类隐藏方式不会体现在
	// 子元素的 computed style 上，所以必须按树剪，不能逐个元素单独判断。
	function collectVisible(root) {
		const out = [];
		const visit = (el) => {
			if (!isVisible(el)) return;
			out.push(el);
			if (el.tagName.toLowerCase() === 'svg') return; // <svg> 整体当成一张图片来画
			for (const child of el.children) visit(child);
		};
		visit(root);
		return out;
	}

	// 往上找第一个不透明的背景色，作为导出图的底色（深色主题下导出的图也不会是透明底）
	function effectiveBackground(el) {
		for (let node = el; node; node = node.parentElement) {
			const bg = styleOf(node).backgroundColor;
			if (!isTransparent(bg)) return bg;
		}
		return '#ffffff';
	}

	function loadImage(src) {
		return new Promise((resolve, reject) => {
			const img = new Image();
			img.onload = () => resolve(img);
			img.onerror = () => reject(new Error('图片加载失败: ' + src.slice(0, 64)));
			img.src = src;
		});
	}

	// ------------------------------ 绘制：背景与边框 ------------------------------
	function paintBox(ctx, el) {
		const rect = el.getBoundingClientRect();
		if (rect.width <= 0 || rect.height <= 0) return;
		const style = styleOf(el);

		if (!isTransparent(style.backgroundColor)) {
			ctx.fillStyle = style.backgroundColor;
			ctx.fillRect(rect.left, rect.top, rect.width, rect.height);
		}

		const side = (width, color, lineStyle, x, y, w, h) => {
			if (!width || lineStyle === 'none' || lineStyle === 'hidden' || isTransparent(color)) return;
			ctx.fillStyle = color;
			ctx.fillRect(x, y, w, h);
		};
		const top = parseFloat(style.borderTopWidth) || 0;
		const right = parseFloat(style.borderRightWidth) || 0;
		const bottom = parseFloat(style.borderBottomWidth) || 0;
		const left = parseFloat(style.borderLeftWidth) || 0;
		side(top, style.borderTopColor, style.borderTopStyle, rect.left, rect.top, rect.width, top);
		side(bottom, style.borderBottomColor, style.borderBottomStyle, rect.left, rect.bottom - bottom, rect.width, bottom);
		side(left, style.borderLeftColor, style.borderLeftStyle, rect.left, rect.top, left, rect.height);
		side(right, style.borderRightColor, style.borderRightStyle, rect.right - right, rect.top, right, rect.height);
	}

	// ------------------------------ 绘制：复选框（任务列表） ------------------------------
	function paintCheckbox(ctx, el) {
		const rect = el.getBoundingClientRect();
		if (rect.width <= 0 || rect.height <= 0) return;
		const color = styleOf(el).color;
		const size = Math.min(rect.width, rect.height);
		ctx.save();
		ctx.strokeStyle = isTransparent(color) ? '#6a7178' : color;
		ctx.lineWidth = Math.max(1, size * 0.08);
		ctx.strokeRect(rect.left + 0.5, rect.top + 0.5, rect.width - 1, rect.height - 1);
		if (el.checked) {
			ctx.beginPath();
			ctx.lineWidth = Math.max(1.2, size * 0.16);
			ctx.lineCap = 'round';
			ctx.lineJoin = 'round';
			ctx.moveTo(rect.left + rect.width * 0.22, rect.top + rect.height * 0.52);
			ctx.lineTo(rect.left + rect.width * 0.44, rect.top + rect.height * 0.74);
			ctx.lineTo(rect.left + rect.width * 0.78, rect.top + rect.height * 0.28);
			ctx.stroke();
		}
		ctx.restore();
	}

	// ------------------------------ 绘制：文本 ------------------------------
	// 把一个文本节点拆成"每个行盒一段"，位置直接取浏览器排好版的结果，
	// 因此换行、列宽、对齐方式都和页面上看到的完全一致，不需要自己实现断行。
	function textLines(node) {
		const range = document.createRange();
		range.selectNodeContents(node);
		const rects = [...range.getClientRects()].filter((r) => r.width > 0 && r.height > 0);
		if (rects.length === 0) return [];
		if (rects.length === 1) return [{text: node.nodeValue, rect: rects[0]}];

		// 多行：逐字符量一次，按行盒 top 分组，得到每一行的文字与位置
		const text = node.nodeValue;
		const groups = [];
		let cur = null;
		for (let i = 0; i < text.length; i++) {
			range.setStart(node, i);
			range.setEnd(node, i + 1);
			const r = range.getBoundingClientRect();
			if (r.width <= 0 && r.height <= 0) continue; // 折行处被吃掉的空格
			if (cur && Math.abs(r.top - cur.top) < 0.5) {
				cur.right = Math.max(cur.right, r.right);
				cur.end = i + 1;
			} else {
				if (cur) groups.push(cur);
				cur = {top: r.top, bottom: r.bottom, left: r.left, right: r.right, start: i, end: i + 1};
			}
		}
		if (cur) groups.push(cur);
		return groups.map((g) => ({
			text: text.slice(g.start, g.end),
			rect: {left: g.left, top: g.top, width: g.right - g.left, height: g.bottom - g.top},
		}));
	}

	function paintTextLine(ctx, text, rect, style) {
		if (!text.trim()) return;
		const metrics = ctx.measureText(text);
		const ascent = metrics.fontBoundingBoxAscent;
		const descent = metrics.fontBoundingBoxDescent;
		let y;
		if (Number.isFinite(ascent) && Number.isFinite(descent) && ascent + descent > 0) {
			// 把字体的 ascent+descent 垂直居中放进行盒，和浏览器分配 half-leading 的结果一致
			ctx.textBaseline = 'alphabetic';
			y = rect.top + (rect.height - (ascent + descent)) / 2 + ascent;
		} else {
			ctx.textBaseline = 'middle';
			y = rect.top + rect.height / 2;
		}
		ctx.textAlign = 'left';

		// canvas 里的字体回退可能和页面不完全一致，按行盒宽度横向微调，保证不串列
		let squeeze = 1;
		if (metrics.width > 0 && rect.width > 0) {
			const ratio = rect.width / metrics.width;
			if (Math.abs(ratio - 1) > 0.02 && ratio > 0.5 && ratio < 2) squeeze = ratio;
		}
		if (squeeze === 1) {
			ctx.fillText(text, rect.left, y);
		} else {
			ctx.save();
			ctx.translate(rect.left, 0);
			ctx.scale(squeeze, 1);
			ctx.fillText(text, 0, y);
			ctx.restore();
		}

		// 删除线 / 下划线（~~文字~~、<u>）
		const decoration = style.textDecorationLine || style.textDecoration || '';
		if (decoration.includes('line-through') || decoration.includes('underline')) {
			const width = squeeze === 1 ? Math.min(metrics.width, rect.width) : rect.width;
			const thickness = Math.max(1, parseFloat(style.fontSize) * 0.07);
			ctx.fillStyle = isTransparent(style.textDecorationColor) ? style.color : style.textDecorationColor;
			if (decoration.includes('line-through')) {
				ctx.fillRect(rect.left, y - (ascent || parseFloat(style.fontSize) * 0.8) * 0.32, width, thickness);
			}
			if (decoration.includes('underline')) {
				ctx.fillRect(rect.left, y + thickness * 1.5, width, thickness);
			}
			ctx.fillStyle = style.color;
		}
	}

	// ------------------------------ 列表项前面的 •/1. ------------------------------
	// ::marker 由浏览器绘制，DOM 里没有对应节点，也量不到位置，只能按首行位置自己补一个
	function markerText(li, listStyleType) {
		const bullets = {disc: '•', circle: '◦', square: '▪'};
		if (bullets[listStyleType]) return bullets[listStyleType];
		const parent = li.parentElement;
		if (!parent) return '•';
		let n = parseInt(parent.getAttribute('start') || '1', 10) || 1;
		for (const sibling of parent.children) {
			if (sibling.tagName !== 'LI') continue;
			const value = parseInt(sibling.getAttribute('value') || '', 10);
			if (Number.isFinite(value)) n = value;
			if (sibling === li) break;
			n++;
		}
		if (parent.tagName !== 'OL') return '•';
		const letter = (base) => String.fromCharCode(base + (n - 1) % 26) + '.';
		if (listStyleType === 'lower-alpha' || listStyleType === 'lower-latin') return letter(97);
		if (listStyleType === 'upper-alpha' || listStyleType === 'upper-latin') return letter(65);
		return `${n}.`;
	}

	function listMarkers(elements) {
		const out = [];
		for (const el of elements) {
			if (el.tagName !== 'LI') continue;
			const style = styleOf(el);
			if (style.listStyleType === 'none' || style.listStylePosition !== 'outside') continue;
			const text = markerText(el, style.listStyleType);
			const rect = el.getBoundingClientRect();
			const fontSize = parseFloat(style.fontSize) || 14;
			// 间距按 Chromium 实测：数字/字母 marker 的右边缘距内容框约 0.43em，
			// 圆点约 0.72em（圆点字形自带右侧留白，所以这里给 0.65em）
			const gap = /[0-9a-zA-Z]/.test(text) ? 0.45 : 0.65;
			out.push({
				text,
				style,
				right: rect.left - fontSize * gap,           // marker 右对齐贴着内容框左边
				top: rect.top + (parseFloat(style.paddingTop) || 0) + (parseFloat(style.borderTopWidth) || 0),
				height: parseFloat(style.lineHeight) || fontSize * 1.5,
				approxWidth: fontSize * 0.62 * text.length,  // 只用于估算导出范围，真正绘制时再精确测量
			});
		}
		return out;
	}

	// ------------------------------ 导出范围 ------------------------------
	// 取"真正会在画布上留下痕迹"的东西的并集：有背景/边框的盒子、图片、复选框、文字行盒。
	// 这样表格不会带上 width:100% 造成的右侧空白（滚动出去的列也不会丢），
	// 段落/列表项也会紧贴文字裁剪，而不是按容器宽度导出一大片空白。
	function contentBounds(elements, markers) {
		let left = Infinity, top = Infinity, right = -Infinity, bottom = -Infinity;
		const add = (rect) => {
			if (!rect || (rect.width <= 0 && rect.height <= 0)) return;
			left = Math.min(left, rect.left);
			top = Math.min(top, rect.top);
			right = Math.max(right, rect.right);
			bottom = Math.max(bottom, rect.bottom);
		};
		const range = document.createRange();
		for (const el of elements) {
			const style = styleOf(el);
			const tag = el.tagName.toLowerCase();
			if (!isTransparent(style.backgroundColor) || hasBorder(style) ||
				tag === 'img' || tag === 'svg' || (tag === 'input' && el.type === 'checkbox')) {
				add(el.getBoundingClientRect());
			}
			for (const node of el.childNodes) {
				if (node.nodeType !== Node.TEXT_NODE || !node.nodeValue || !node.nodeValue.trim()) continue;
				range.selectNodeContents(node);
				for (const rect of range.getClientRects()) add(rect);
			}
		}
		for (const m of markers) {
			add(new DOMRect(m.right - m.approxWidth, m.top, m.approxWidth, m.height));
		}
		return {left, top, right, bottom};
	}

	// ------------------------------ 把一块内容画到 canvas ------------------------------
	async function blockToCanvas(root) {
		const elements = collectVisible(root);
		const markers = listMarkers(elements);
		let bounds = contentBounds(elements, markers);
		if (!Number.isFinite(bounds.left) || bounds.right <= bounds.left) bounds = root.getBoundingClientRect();
		const originX = bounds.left;
		const originY = bounds.top;
		const width = bounds.right - originX + PADDING * 2;
		const height = bounds.bottom - originY + PADDING * 2;

		let scale = EXPORT_SCALE;
		const limit = Math.min(MAX_CANVAS_SIDE / width, MAX_CANVAS_SIDE / height);
		if (limit < scale) {
			scale = Math.max(limit, 0.25);
			console.warn('[table-export-png] 内容过大，导出倍率降到', scale.toFixed(2));
		}

		const canvas = document.createElement('canvas');
		canvas.width = Math.ceil(width * scale);
		canvas.height = Math.ceil(height * scale);
		const ctx = canvas.getContext('2d');
		ctx.scale(scale, scale);
		ctx.fillStyle = effectiveBackground(root);
		ctx.fillRect(0, 0, width, height);
		// 之后所有绘制都可以直接使用 getBoundingClientRect() 的视口坐标
		ctx.translate(PADDING - originX, PADDING - originY);

		// 1) 背景与边框
		for (const el of elements) paintBox(ctx, el);

		// 2) 图片 / 内联 SVG / 复选框（先并发加载，再统一绘制，保证叠放顺序稳定）
		const pending = [];
		for (const el of elements) {
			const tag = el.tagName.toLowerCase();
			if (tag === 'img') {
				pending.push(imageOf(el).then((img) => img && {img, rect: el.getBoundingClientRect()}));
			} else if (tag === 'svg') {
				pending.push(svgImageOf(el).then((img) => img && {img, rect: el.getBoundingClientRect()}));
			} else if (tag === 'input' && el.type === 'checkbox') {
				paintCheckbox(ctx, el);
			}
		}
		for (const item of await Promise.all(pending)) {
			if (!item || item.rect.width <= 0 || item.rect.height <= 0) continue;
			try {
				ctx.drawImage(item.img, item.rect.left, item.rect.top, item.rect.width, item.rect.height);
			} catch (err) {
				console.warn('[table-export-png] 图片绘制失败，已跳过：', err);
			}
		}

		// 3) 文本（只遍历可见元素的直接子文本节点，被剪掉的子树自然不会被画）
		for (const el of elements) {
			let style = null;
			for (const node of el.childNodes) {
				if (node.nodeType !== Node.TEXT_NODE || !node.nodeValue || !node.nodeValue.trim()) continue;
				if (!style) {
					style = styleOf(el);
					ctx.fillStyle = style.color;
					ctx.font = `${style.fontStyle} ${style.fontWeight} ${style.fontSize} ${style.fontFamily}`;
					if ('letterSpacing' in ctx) {
						ctx.letterSpacing = style.letterSpacing === 'normal' ? '0px' : style.letterSpacing;
					}
				}
				for (const line of textLines(node)) paintTextLine(ctx, line.text, line.rect, style);
			}
		}

		// 4) 列表项的 •/1.
		for (const m of markers) {
			ctx.fillStyle = m.style.color;
			ctx.font = `${m.style.fontStyle} ${m.style.fontWeight} ${m.style.fontSize} ${m.style.fontFamily}`;
			const w = ctx.measureText(m.text).width;
			paintTextLine(ctx, m.text, {left: m.right - w, top: m.top, width: w, height: m.height}, m.style);
		}

		return canvas;
	}

	// 跨域图片会污染 canvas，导致后面 toBlob 直接抛 SecurityError，所以宁可跳过
	async function imageOf(img) {
		const src = img.currentSrc || img.src;
		if (!src) return null;
		if (!src.startsWith('data:')) {
			try {
				if (new URL(src, location.href).origin !== location.origin) {
					console.warn('[table-export-png] 跳过跨域图片（会污染 canvas）：', src);
					return null;
				}
			} catch {
				return null;
			}
		}
		if (img.complete && img.naturalWidth > 0) return img;
		try {
			await img.decode();
			return img;
		} catch {
			return null;
		}
	}

	// 内联 SVG（图标等）：序列化成 data: URL 再当普通图片画。
	// 用 data: 而不是 blob:，前者在 Chrome 里不会污染 canvas。
	async function svgImageOf(svg) {
		try {
			const rect = svg.getBoundingClientRect();
			const clone = svg.cloneNode(true);
			clone.setAttribute('xmlns', 'http://www.w3.org/2000/svg');
			clone.setAttribute('width', String(rect.width));
			clone.setAttribute('height', String(rect.height));
			// SVG 图像里读不到页面的 CSS，把当前颜色内联进去（图标常用 fill: currentColor）
			const style = styleOf(svg);
			clone.style.color = style.color;
			if (style.fill && style.fill !== 'none') clone.style.fill = style.fill;
			const text = new XMLSerializer().serializeToString(clone);
			return await loadImage('data:image/svg+xml;charset=utf-8,' + encodeURIComponent(text));
		} catch (err) {
			console.warn('[table-export-png] 内联 SVG 导出失败，已跳过：', err);
			return null;
		}
	}

	// ------------------------------ 文件名 ------------------------------
	// 标题里如果有公式，textContent 会把 KaTeX 那份只给读屏软件的 MathML 也读进来，去掉它
	function visibleText(el) {
		const clone = el.cloneNode(true);
		for (const hidden of clone.querySelectorAll('.katex-mathml')) hidden.remove();
		return clone.textContent.trim().replace(/\s+/g, ' ');
	}

	function fileNameFor(el) {
		let title = '';
		let root = null;
		for (let node = el; node && !title; node = node.parentElement) {
			for (let prev = node.previousElementSibling; prev; prev = prev.previousElementSibling) {
				if (/^H[1-6]$/.test(prev.tagName)) {
					title = visibleText(prev);
					break;
				}
			}
			if (node.classList && node.classList.contains('markup')) {
				root = node;
				break;
			}
		}
		if (!title) title = (document.title || 'export').split(/[·|]/)[0].trim();
		const tag = el.tagName.toLowerCase();
		const index = [...(root || document).querySelectorAll(tag)].indexOf(el) + 1;
		const safe = title.replace(/[\\/:*?"<>|\s]+/g, '-').replace(/^-+|-+$/g, '').slice(0, 60) || 'export';
		return `${safe}-${tag}-${index}.png`;
	}

	// ------------------------------ 导出按钮 ------------------------------
	const button = document.createElement('button');
	button.type = 'button';
	button.className = 'ui mini button';
	button.title = '把这一块内容导出为 PNG 图片';
	button.textContent = '⤓ PNG';
	button.style.cssText = [
		'position:fixed', 'z-index:200', 'display:none', 'padding:4px 8px',
		'line-height:1.2', 'font-size:12px', 'cursor:pointer', 'opacity:0.9',
	].join(';');
	// 允许把这段脚本放进 header.tmpl（那时 <body> 还不存在）
	if (document.body) document.body.appendChild(button);
	else addEventListener('DOMContentLoaded', () => document.body.appendChild(button), {once: true});

	let target = null;

	function hide() {
		target = null;
		button.style.display = 'none';
	}

	function place() {
		if (!target || !target.isConnected) return hide();
		const rect = target.getBoundingClientRect();
		if (rect.bottom < 0 || rect.top > innerHeight || rect.width <= 0) return hide();
		button.style.display = 'block';
		const w = button.offsetWidth;
		const h = button.offsetHeight;
		// 贴在表格右上角，长表格滚动时按钮跟着停在可见区域内
		const left = Math.max(6, Math.min(rect.right - w - 6, innerWidth - w - 6));
		const top = Math.min(Math.max(rect.top + 6, 6), Math.max(rect.bottom - h - 6, 6));
		button.style.left = `${left}px`;
		button.style.top = `${top}px`;
	}

	document.addEventListener('pointerover', (e) => {
		const el = e.target instanceof Element ? e.target : null;
		if (!el || button.contains(el)) return;
		const block = exportTarget(el);
		if (block) {
			target = block;
			place();
		} else {
			hide();
		}
	});
	addEventListener('scroll', place, {passive: true, capture: true});
	addEventListener('resize', place);

	button.addEventListener('click', async () => {
		const block = target;
		if (!block || button.disabled) return;
		const label = button.textContent;
		button.disabled = true;
		button.textContent = '⏳ …';
		try {
			const canvas = await blockToCanvas(block);
			const blob = await new Promise((resolve) => canvas.toBlob(resolve, 'image/png'));
			if (!blob) throw new Error('PNG 编码失败');
			const a = document.createElement('a');
			a.href = URL.createObjectURL(blob);
			a.download = fileNameFor(block);
			a.click();
			setTimeout(() => URL.revokeObjectURL(a.href), 10000);
			button.textContent = '✓ PNG';
		} catch (err) {
			console.error('[table-export-png] 导出失败：', err);
			button.textContent = '✗ 失败';
		} finally {
			setTimeout(() => {
				button.textContent = label;
				button.disabled = false;
			}, 1500);
		}
	});
})();
</script>
